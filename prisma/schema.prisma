generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Auth (Better Auth) models
// ---------------------------------------------------------------------------

model AccessType {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions Json     @default("{}")
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]

  @@index([name])
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  cpf           String?   @unique
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accessTypeId String
  accessType   AccessType @relation(fields: [accessTypeId], references: [id])

  sessions Session[]
  accounts Account[]
  houses   House[]   @relation("HouseCreatedBy")
  audits   Audit[]

  @@index([email])
  @@index([accessTypeId])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  order     Int      @default(0)
  createdAt DateTime @default(now())

  houses House[]
}

enum ListingType {
  SALE
  RENT
}

enum HouseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  SOLD
  RENTED
}

model House {
  id          String      @id @default(cuid())
  title       String
  slug        String      @unique
  description String
  price       Decimal     @db.Decimal(14, 2)
  listingType ListingType @default(SALE)
  status      HouseStatus @default(DRAFT)

  address      String
  neighborhood String
  city         String  @default("Uberlândia")
  state        String  @default("MG")
  zipCode      String?
  latitude     Decimal? @db.Decimal(10, 7)
  longitude    Decimal? @db.Decimal(10, 7)

  builtArea Decimal @default(0) @db.Decimal(10, 2)
  totalArea Decimal @default(0) @db.Decimal(10, 2)
  bedrooms      Int     @default(0)
  bathrooms     Int     @default(0)
  garageSpaces  Int     @default(0)
  hasPool       Boolean @default(false)
  hasBarbecue   Boolean @default(false)
  condoFee      Decimal? @db.Decimal(12, 2)
  iptu          Decimal? @db.Decimal(12, 2)
  videoUrl      String?
  tags          String[] @default([])

  viewsCount  Int       @default(0)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  createdById String?
  createdBy   User?   @relation("HouseCreatedBy", fields: [createdById], references: [id])

  images    HouseImage[]
  documents HouseDocument[]
  favorites Favorite[]
  interests Interest[]

  @@index([status, listingType])
  @@index([city, neighborhood])
  @@index([categoryId])
  @@index([createdAt])
}

model HouseImage {
  id           String   @id @default(cuid())
  key          String
  url          String
  isCover      Boolean  @default(false)
  order        Int      @default(0)
  type         String?
  size         Int?
  originalName String?
  uploadedAt   DateTime @default(now())

  houseId String
  house   House  @relation(fields: [houseId], references: [id], onDelete: Cascade)

  @@index([houseId])
}

model HouseDocument {
  id           String   @id @default(cuid())
  key          String
  url          String
  type         String?
  size         Int?
  originalName String?
  uploadedAt   DateTime @default(now())

  houseId String
  house   House  @relation(fields: [houseId], references: [id], onDelete: Cascade)

  @@index([houseId])
}

// ---------------------------------------------------------------------------
// CRM
// ---------------------------------------------------------------------------

model Client {
  id          String   @id @default(cuid())
  name        String
  phone       String
  hasWhatsapp Boolean  @default(false)
  email       String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  favorites  Favorite[]
  interests  Interest[]
  metadata   Metadata?
  activities ClientActivity[]

  @@unique([phone])
  @@index([createdAt])
}

model Favorite {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  houseId String
  house   House  @relation(fields: [houseId], references: [id], onDelete: Cascade)

  @@unique([clientId, houseId])
  @@index([houseId])
}

enum InterestSource {
  SITE
  WHATSAPP
  ADMIN
}

enum FunnelStage {
  LEAD
  QUALIFIED
  VISIT_SCHEDULED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

model Interest {
  id        String         @id @default(cuid())
  source    InterestSource @default(SITE)
  stage     FunnelStage    @default(LEAD)
  notes     String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  houseId String
  house   House  @relation(fields: [houseId], references: [id], onDelete: Cascade)

  @@unique([clientId, houseId])
  @@index([clientId])
  @@index([houseId])
}

model Metadata {
  id                   String      @id @default(cuid())
  incomeRange          String?
  maritalStatus        String?
  desiredPropertyType  String?
  desiredNeighborhood  String?
  observations         String?
  funnelStage          FunnelStage @default(LEAD)
  preferences          Json?
  lastContactAt        DateTime?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  clientId String @unique
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

enum ActivityType {
  MESSAGE
  HOUSE_SENT
  METADATA_UPDATE
  INTEREST_ADDED
  CONTACT_REQUEST
}

model ClientActivity {
  id        String       @id @default(cuid())
  type      ActivityType
  payload   Json?
  createdAt DateTime     @default(now())

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt])
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

enum AuditAction {
  LOGIN
  LOGOUT
  CREATE
  UPDATE
  DELETE
  VIEW
  UPLOAD
}

model Audit {
  id         String      @id @default(cuid())
  action     AuditAction
  entityType String
  entityId   String?
  ip         String?
  userAgent  String?
  device     String?
  metadata   Json?
  createdAt  DateTime    @default(now())

  actorId    String?
  actor      User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail String?

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
}
